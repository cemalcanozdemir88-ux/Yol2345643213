            <hr />

            <h3><strong>Hash Calculation Example</strong></h3>
            <p>An example of how the <span class="text-danger">hash</span> is encrypted:</p>

            <pre>
                <code>
                    
    <span class="hljs-comment">// PHP code to calculate hash</span>
    $transaction_id = <span>uniqid()</span>; <span class="hljs-comment">// Generating a unique transaction ID</span>
    $userID = <span class="text-danger">'YOUR_USER_ID'</span>; <span class="hljs-comment">// Replace with the actual user ID</span>
    $client_id = <span class="text-danger">'YOUR_CLIENT_ID'</span>; <span class="hljs-comment">// Replace with your actual client ID</span>
    $client_secret = <span class="text-danger">'YOUR_CLIENT_SECRET'</span>; <span class="hljs-comment">// Replace with your actual client secret</span>

    $hash = sha1($transaction_id . $userID . $client_id  . client_secret);

    <span class="hljs-keyword">echo</span> $hash;
                    
                </code>
            </pre>

            

