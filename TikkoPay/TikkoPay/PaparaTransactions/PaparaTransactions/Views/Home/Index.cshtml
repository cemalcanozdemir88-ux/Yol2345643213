@{
	Layout = null;
}

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
	<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">

	<title>TikkoPay Papara</title>

	<meta name="content-language" content="tr">
	<meta name="resource-type" content="document">
	<meta name="apple-mobile-web-app-capable" content="yes" />
	<meta name="apple-mobile-web-app-status-bar-style" content="black" />
	<meta name="msapplication-TileColor" content="#da532c">
	<meta name="theme-color" content="#ffffff">

	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	<link rel="stylesheet" href="~/v3/assets/css/style.css" />

    <script src="~/v2/assets/js/jquery-3.5.1.min.js"></script>

</head>
<body class="bg-ligth">

    <div class="container py-2">
        <div class="card shadow-sm payment-card mx-auto">
			<div class="card-header bg-orange text-white py-2">
				<div class="d-flex align-items-center justify-content-center gap-3">
					<i class="bi bi-bank2 header-icon"></i>
					<h4 class="mb-0">TikkoPay Papara</h4>
				</div>
			</div>

			<div id="loader" class="text-center p-5">
				<div class="spinner-container mb-3">
					<div class="spinner-border text-orange-500" role="status" style="width: 3rem; height: 3rem;">
						<span class="visually-hidden">Bekleyiniz...</span>
					</div>
				</div>
				<p class="text-gray-600">Banka hesap bilgileri hazırlanıyor...</p>
			</div>

            <div id="errorBlock" class="card-body p-4" style="display:none;">
				<div id="errorMessage" class="alert alert-danger text-center fs-8 fw-bold mb-0">
				</div>
			</div>

            <div class="card-body p-4" id="formBlock" style="display:none;">

				<form>
					@Html.AntiForgeryToken()
                    <input type="hidden" id="havaleBankId" name="havaleBankId" />
					<div class="d-flex justify-content-between align-items-center mb-4">
						<div>
							<p class="text-muted mb-1">Yatırım Tutarı</p>
							<h2 class="text-orange fw-bold mb-0" id="amount-value"></h2>
						</div>
						<div class="timer-container text-end">
							<p class="text-muted mb-1">Kalan Süre</p>
                            <div class="text-orange fw-bold timer-display">
                                <span id="timeOut">00:00</span>
                            </div>
						</div>
					</div>

					<div class="mb-4">
                        <label class="form-label text-muted">Hesap Adi</label>
						<div class="input-group">
                            <input type="text" class="form-control" id="accountName" name="accountName" readonly>
                            <button class="btn btn-outline-orange copy-btn" type="button" data-bs-toggle="tooltip" title="Kopyala">
								<i class="bi bi-clipboard"></i>
							</button>
						</div>
					</div>

					<div class="mb-4">
						<label class="form-label text-muted">IBAN</label>
						<div class="input-group">
                            <input type="text" class="form-control" id="accountNumber" name="accountNumber" readonly>
							<button class="btn btn-outline-orange copy-btn" type="button" data-bs-toggle="tooltip" title="Kopyala">
								<i class="bi bi-clipboard"></i>
							</button>
						</div>
					</div>

                    <button id="paymentButton" class="btn gradient-button w-100 py-3 mb-4" type="button" onclick="SendTransaction()">
						<span class="normal-text">YATIRIM YAPTIM</span>
						<span class="loading-text d-none">
							<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
							Bekleyiniz...
						</span>
					</button>

				</form>



				<div class="alert alert-warning mb-0" role="alert">
					<ul>
						<li><small>Yatırımınız yukarıda belirtilen tutarda olmalıdır.</small></li>
						<li><small>Kendi adınıza ait papara hesabından para yatırma işlemi gerçekleştiriniz.</small></li>
						<li><small>Bankanızdan transfer işlemi yaparken açıklama kısmını boş bırakınız.</small></li>
					</ul>
				</div>
			</div>
		</div>
	</div>

	<!-- Success Modal -->
	<div class="modal fade" id="successModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-body text-center p-4">
					<div class="success-animation mb-4">
						<i class="bi bi-check-circle-fill text-orange display-1"></i>
					</div>
                    <h4 class="mb-3">Yatırım Talebiniz Alındı</h4>
                    <p class="text-muted mb-4">İşleminiz en kısa süre sonuçlandırılıp bakiyenize yansıyacaktır..</p>
					<button id="redirectButton" type="button" class="btn gradient-button px-4 py-2">TAMAM</button>
				</div>
			</div>
		</div>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
	<script src="~/v3/assets/js/script.js"></script>

    <script type="text/javascript">

        var seconds = 10;
        var referrerUrl = "";

        const paymentButton = document.getElementById('paymentButton');
        const successModal = new bootstrap.Modal(document.getElementById('successModal'), {
           backdrop: 'static',
           keyboard: false
        });

        $(document).ready(function () {
            $("#countdown").text(seconds);

            referrerUrl = document.referrer;

            GetValidBankAccount();
        });

        function SendTransaction() {
            paymentButton.disabled = true;
            paymentButton.querySelector('.normal-text').classList.add('d-none');
            paymentButton.querySelector('.loading-text').classList.remove('d-none');

            let havaleBankId = $("#havaleBankId").val();
            let transactionId = "@Context.Request.Query["transaction"]";
            let data = JSON.stringify({ havaleBankId: havaleBankId, transactionId: transactionId });

            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("SendTransaction", "Home")',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token },
                data: data,
                success: function (response) {

                    if (!response.status) {
                        $("#loader").hide();
                        $("#formBlock").hide();

                        $("#errorMessage").empty().text(response.message);
                        $("#errorBlock").show();
                    }
                    else {

                        $("#loader").hide();
                        $("#formBlock").hide();
                        
                        let redirectUrl = referrerUrl;
                        if(redirectUrl === "" || 
                           redirectUrl == undefined || 
                           redirectUrl == null) {

                            redirectUrl = response.model;
                        }

                        $("#redirectButton").off("click").on("click", function () {
                          window.location.href = redirectUrl;
                        });

                        successModal.show();
                    }
                },
                error: function (xhr, status, error) {
                    $("#loader").hide();
                    $("#formBlock").hide();

                    $("#errorMessage").empty().text("Hata oluştu!. Bir süre sonra tekrar deneyiniz.");
                    $("#errorBlock").show();
                }
            });

            return false;
        }

        function Redirect(redirectUrl) {

            var countdownElement = document.getElementById("countdown");

            var timer = setInterval(function () {
                seconds--;
                countdownElement.innerHTML = seconds;
                if (seconds <= 1) {
                    clearInterval(timer);
                    location.href = redirectUrl;
                }
            }, 1000);
        }

        function GetValidBankAccount() {
            var transactionId = "@Context.Request.Query["transaction"]";
            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("GetValidBankAccount", "Home")',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token },
                data: JSON.stringify(transactionId),
                success: function (response) {
                    if (!response.status) {
                        $("#loader").hide();
                        $("#formBlock").hide();

                        $("#errorMessage").empty().text(response.message);
                        $("#errorBlock").show();
                    }
                    else {

                        $("#havaleBankId").val(response.model.id);
                        $("#amount-value").text(response.model.amount + " TRY");
                        $("#accountName").val(response.model.hesapSahibi);
                        $("#accountNumber").val(response.model.hesapNo);

                        var sayac = JSON.parse(response.model.timeLeft);
                        $("#timeOut").html(convertStoMs(sayac));
                        setTimer(sayac);


                        $("#errorBlock").hide();
                        $("#loader").hide();
                        $("#formBlock").show();
                    }
                },
                error: function (xhr, status, error) {
                    $("#loader").hide();
                    $("#formBlock").hide();

                    $("#errorMessage").empty().text("Hata oluştu!. Bir süre sonra tekrar deneyiniz.");
                    $("#errorBlock").show();
                }
            })
        }

        function setTimer(sayac) {
            var geriSayac = setInterval(function () {
                sayac--;

                if (sayac <= 0) {
                    clearInterval(geriSayac);

                    $("#loader").hide();
                    $("#formBlock").hide();

                    $("#errorMessage").empty().text("İşlem zaman aşımına uğradı!");
                    $("#errorBlock").show();

                } else {
                    $("#timeOut").html(convertStoMs(sayac));
                }
            }, 1000);
        }

        function convertStoMs(seconds) {
            let minutes = ~~(seconds / 60);
            let extraSeconds = Math.floor(seconds % 60);
            let minutesText = minutes < 10 ? "0" + minutes : minutes;
            let extraSecondsText = extraSeconds < 10 ? "0" + extraSeconds : extraSeconds;
            return minutesText + ":" + extraSecondsText;
        }

    </script>

</body>
</html>