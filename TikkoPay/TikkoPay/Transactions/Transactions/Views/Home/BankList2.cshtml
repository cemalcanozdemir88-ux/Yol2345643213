@using Transactions.Models.ViewModels
@model BankListViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">

    <title>TikkoPay Havale</title>

    <meta name="robots" content="noindex, nofollow">
    <meta name="content-language" content="tr">
    <meta name="resource-type" content="document">
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">

    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700,800&amp;subset=cyrillic,cyrillic-ext,greek,greek-ext,latin-ext,vietnamese" rel="stylesheet">

    <link href="~/v2/assets/js/bootstrap/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true">
    <link href="~/v2/assets/css/style.min.css" rel="stylesheet" asp-append-version="true">
    <link href="~/v2/assets/css/custom.css" rel="stylesheet" asp-append-version="true">

    <script src="~/v2/assets/js/jquery-3.5.1.min.js"></script>
    <script src="~/v2/assets/js/sweetalert2.min.js"></script>

    <script src="~/v2/assets/js/jquery.priceformat.min.js"></script>
    <script src="~/v2/assets/js/jquery.mask.min.js"></script>
    <script src="~/v2/assets/js/clipboard.min.js"></script>

    <style>
        .btn-outline-primary {
            color: rgba(13, 110, 253, .25) !important;
            border-color: #0a58ca !important;
        }

        .form-control:disabled, .form-control[readonly] {
            background-color: #ffffff;
            opacity: 1;
        }

        .form-float .form-label {
            z-index: 10;
        }

        .amntPrefix {
            right: 58px !important;
            z-index: 10;
        }

        .btn-outline-secondary {
            color: rgba(13, 110, 253, .25) !important;
            border-color: #0a58ca !important;
        }

        .form-float .form-label {
            z-index: 10;
        }

        .amntPrefix {
            right: 58px !important;
            z-index: 10;
        }


        .bank-button {
            cursor: pointer;
            text-align: center;
        }

            .bank-button:hover {
                background-color: rgba(13, 110, 253, .25) !important;
                border-color: #0a58ca !important;
            }

            .bank-button img {
                max-width: 100%;
            }

            .bank-button:hover img {
                transform: scale(1.05);
            }
    </style>

</head>
<body style="max-height:900px;">

    <div class="container-fluid container-xxl">
        <div class="row d-flex flex-column min-vh-100 justify-content-center align-items-center">
            <div class="col-12">
                <div class="cards apscard">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-xs-12 text-center">
                                <img src="~/v2/assets/images/tikkopay-havale-v2.png" class="mw-100 mb-2" height="64" alt="TikkoPay">
                            </div>
                        </div>
                    </div>
                    <div class="card-body" id="divMainContent">

                        @if(Model.IsError)
                        {
                            <div id="errorBlock" class="row justify-content-center ">
                                <div id="errorMessage" class="alert alert-danger text-center fs-8 fw-bold mb-0">
                                    @Model.ErrorMessage
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="row justify-content-center ">
                                <div class="col-xs-12 col-sm-12 col-md-9 col-lg-8">
                                    <div class="mt-1">

                                        <p class="fs-5 text-center mb-4" style="color: #0a58ca;">Lütfen yatırım yapmak istediğiniz bankayı seçiniz.</p>

                                        <div class="row">

                                            @foreach (var item in Model.Bankalar)
                                            {
                                                <div class="col-xs-4 col-sm-3 col-md-3 col-lg-3 mb-3">
                                                    <div class="card p-1 bank-button">
                                                        <a href="@Url.Action("Index", "Home", new {transaction=Model.TransactionId,  banka = item.Id }).Replace("/Home/Index", "/")" class="btnBankId">
                                                            <img src="@Url.Content("~/v2/assets/images/banks/")@item.Resim" alt="@item.Baslik">
                                                        </a>
                                                    </div>
                                                </div>
                                            }


                                        </div>

                                    </div>
                                </div>
                            </div>
                        }

                        
                    </div>
                </div>
            </div>

        </div>
    </div>

</body>
</html>