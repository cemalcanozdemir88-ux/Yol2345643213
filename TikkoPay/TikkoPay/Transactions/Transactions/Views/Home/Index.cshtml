@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">

    <title>@ViewBag.WebsiteTitle Havale</title>

    <meta name="robots" content="noindex, nofollow">
    <meta name="content-language" content="tr">
    <meta name="resource-type" content="document">
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/v3/styles/custom.css" asp-append-version="true">
    <link rel="stylesheet" href="~/v3/styles/success.css" asp-append-version="true">


    <script src="~/v2/assets/js/jquery-3.5.1.min.js"></script>
    <script src="~/v2/assets/js/sweetalert2.min.js"></script>

    <script src="~/v2/assets/js/jquery.priceformat.min.js"></script>
    <script src="~/v2/assets/js/jquery.mask.min.js"></script>
    <script src="~/v2/assets/js/clipboard.min.js"></script>

    <style>
        .page-blur {
            filter: blur(15px); /* İçeriğin tamamen okunamaz olması için yüksek değer */
            pointer-events: none; /* Arkadaki butonlara tıklanmasını engeller */
            user-select: none; /* Metin seçimini engeller */
            transition: filter 0.3s ease;
        }
    </style>

</head>
<body>

    <div id="content-wrapper" class="container py-2 page-blur">
        <div class="card payment-card mx-auto">
            <!-- Logo -->
            <div class="logo-container">
                <div class="logo-icon">
                    <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                        <path d="M20 4L4 12H36L20 4Z" fill="white" />
                        <rect x="6" y="12" width="28" height="4" fill="white" />
                        <rect x="8" y="16" width="4" height="16" fill="white" />
                        <rect x="18" y="16" width="4" height="16" fill="white" />
                        <rect x="28" y="16" width="4" height="16" fill="white" />
                        <rect x="4" y="32" width="32" height="4" fill="white" />
                    </svg>
                </div>
                <h1 class="logo-text">@ViewBag.WebsiteTitle Havale</h1>
            </div>

            <!-- Loading State -->
            <div id="loader" class="text-center p-5">
                <div class="spinner-container mb-3">
                    <div class="spinner-border text-orange-500" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Bekleyiniz...</span>
                    </div>
                </div>
                <p class="text-gray-600">Banka hesap bilgileri hazırlanıyor...</p>
            </div>

            <div id="errorBlock" class="row justify-content-center" style="display:none;">
                <div id="errorMessage" class="alert alert-danger text-center fs-8 fw-bold mb-0">
                </div>
            </div>

            <!-- Welcome Message -->
            <div class="welcome-section" id="welcomeBlock" style="display:none;">
                <p class="text-center mb-0">
                    <span class="text-muted">Hoş geldiniz</span>
                    <span class="customer-name ms-1" id="fullName"></span>
                    <small class="text-muted d-block">Kullanıcı adı: <span id="username" class="customer-name"></span></small>
                </p>
            </div>

            <!-- Content -->
            <div class="card-body p-4" id="formBlock" style="display:none;">


                <form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="havaleBankId" name="havaleBankId" />

                    <!-- Amount -->
                    <div class="text-center mb-4">
                        <small class="text-muted d-block mb-1">Yatırım Tutarı</small>
                        <h2 class="amount mb-0" id="amount-value"></h2>
                    </div>

                    <!-- Account Details -->
                    <div class="mb-4">
                        <div class="mb-3">
                            <label class="form-label">Hesap Adı</label>
                            <div class="input-group input-group-custom">
                                <input type="text" class="form-control" id="accountName" name="accountName" readonly>
                                <button class="btn btn-outline-secondary copy-btn clipboard" id="copyAccountName" data-clipboard-target="#accountName" type="button">
                                    <svg class="copy-icon" viewBox="0 0 24 24" width="18" height="18">
                                        <path d="M8 4v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7.242a2 2 0 0 0-.602-1.43L16.083 2.57A2 2 0 0 0 14.685 2H10a2 2 0 0 0-2 2Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                                        <path d="M16 18v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">IBAN</label>
                            <div class="input-group input-group-custom">
                                <input type="text" class="form-control font-monospace" id="accountNumber" name="accountNumber" readonly>
                                <button class="btn btn-outline-secondary copy-btn clipboard" id="copyaccountNumber" data-clipboard-target="#accountNumber" type="button">
                                    <svg class="copy-icon" viewBox="0 0 24 24" width="18" height="18">
                                        <path d="M8 4v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7.242a2 2 0 0 0-.602-1.43L16.083 2.57A2 2 0 0 0 14.685 2H10a2 2 0 0 0-2 2Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                                        <path d="M16 18v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <!-- Payment Button -->
                        <a class="btn btn-primary w-100 py-3 mb-4 btnPaparaYatirimiYaptim" onclick="CompleteTransaction()" type="button">
                            ÖDEME YAPTIM
                        </a>

                        <!-- Timer -->
                        <div class="timer-container text-center p-3 mb-4">
                            <small class="text-muted d-block mb-1">Kalan Süre</small>
                            <div class="timer-value" id="timeOut">00:00</div>
                        </div>

                        <!-- Info Box -->
                        <div class="alert alert-warning" role="alert">
                            <ul>
                                <li><small>Yatırımınız yukarıda belirtilen tutarda olmalıdır.</small></li>
                                <li><small>Kendi adınıza ait banka hesabından para yatırma işlemi gerçekleştiriniz.</small></li>
                                <li><small>Bankanızdan transfer işlemi yaparken açıklama kısmını boş bırakınız.</small></li>
                            </ul>
                        </div>
                    </div>

                </form>


            </div>

            <div class="card-body text-center p-4" id="successBlock" style="display:none;">
                <div class="success-icon-container mb-4">
                    <div class="success-icon">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </div>
                </div>

                <!-- Success Message -->
                <h2 class="success-title mb-3">Yatırım Talebiniz Alındı</h2>
                <p class="success-message mb-4">
                    İşleminiz en kısa süre sonuçlandırılıp bakiyenize yansıyacaktır.
                </p>

                <!-- Transaction Details -->
                <div class="transaction-details p-3 mb-4">
                    <div class="row">
                        <div class="col-6 text-start">
                            <small class="text-muted">Yatırım Tutarı</small>
                            <p class="mb-0 fw-bold" id="amount-value2"></p>
                        </div>
                        <div class="col-6 text-start">
                            <small class="text-muted">Durum</small>
                            <p class="mb-0 text-success fw-bold">İnceleniyor</p>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <div id="popup-overlay" class="modal-backdrop fade show"></div>
    <div class="modal fade show" id="popup-modal" tabindex="-1" style="display: block;" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 448px;">
            <div class="modal-content border-0 shadow-lg rounded-4">

                <div class="modal-body px-4 pb-4 pt-5 text-center">
                    <div class="mx-auto d-flex align-items-center justify-content-center rounded-circle mb-4"
                         style="width: 80px; height: 80px; background-color: #fef3c7;">
                        <svg class="text-warning" style="width: 48px; height: 48px;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                    </div>

                    <h3 class="h4 fw-bold text-dark mb-4">Önemli Uyarı!!</h3>

                    <p class="text-secondary text-start mb-4">
                        Minimum yatırım tutarından düşük gönderimlerinizde tutar tarafınıza <b>24 saat sonra iade edilecektir</b>. <br /><br />
                        Minimum yatırım tutarı altında gönderim <b>yapmamanızı</b> rica ederiz.
                    </p>

                    <button type="button" id="close-popup-btn" class="btn btn-primary w-100 py-3 fw-bold shadow-sm">
                        Anladım
                    </button>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/v2/assets/js/jquery.main.js"></script>
    <script type="text/javascript">

        var seconds = 10;
        var redirectUrl = "";
        var getValidBankAccountErrorCount = 0;

        $(document).ready(function () {

            $('#popup-overlay').show();
            $('#popup-modal').show();

            $('#close-popup-btn').click(function() {
                $('#popup-overlay').fadeOut();
                $('#popup-modal').fadeOut();
                $('#content-wrapper').removeClass('page-blur');
            });

            $("#countdown").text(seconds);
            new ClipboardJS('.clipboard');

            redirectUrl = document.referrer;

            GetValidBankAccount();
        });

        function CompleteTransaction() {
            $("#loader").hide();
            $("#formBlock").hide();
            $("#successBlock").show();

            Redirect();

            return false;
        }

        function Redirect() {

            var timer = setInterval(function () {
                seconds--;
                if (seconds <= 1) {
                    clearInterval(timer);
                    location.href = redirectUrl;
                }
            }, 1000);
        }

        function GetValidBankAccount() {
            var transactionId = "@Context.Request.Query["transaction"]";
            var bankaId = "@Context.Request.Query["banka"]";
            var token = $('input[name="__RequestVerificationToken"]').val();

            var dataToSend = {
                transactionId: transactionId,
                bankaId: bankaId
            };

            $.ajax({
                url: '@Url.Action("GetValidBankAccount", "Home")',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token },
                data: JSON.stringify(dataToSend),
                success: function (response) {
                    if (!response.status) {
                        $("#loader").hide();
                        $("#welcomeBlock").hide();
                        $("#formBlock").hide();


                        $("#errorMessage").empty().text(response.message);
                        $("#errorBlock").show();
                    }
                    else {

                        $("#havaleBankId").val(response.model.id);
                        $("#amount-value").text("₺ " + response.model.amount);
                        $("#amount-value2").text("₺ " + response.model.amount);
                        $("#accountName").val(response.model.hesapSahibi);
                        $("#accountNumber").val(response.model.hesapNo);
                        $("#fullName").text(response.model.fullname);
                        $("#username").text(response.model.username);

                        if(redirectUrl === "" ||
                           redirectUrl == undefined ||
                           redirectUrl == null) {

                            redirectUrl = response.model.webSiteUrl;
                        }
                        
                        var sayac = JSON.parse(response.model.timeLeft);
                        $("#timeOut").html(convertStoMs(sayac));
                        setTimer(sayac);

                        $("#errorBlock").hide();
                        $("#loader").hide();
                        $("#welcomeBlock").show();
                        $("#formBlock").show();
                    }
                },
                error: function (xhr, status, error) {
                    getValidBankAccountErrorCount++;

                    if (getValidBankAccountErrorCount == 1) {
                        GetValidBankAccount();
                    }
                    else {
                        $("#loader").hide();
                        $("#formBlock").hide();
                        $("#welcomeBlock").hide();

                        $("#errorMessage").empty().text("Hata oluştu!. Bir süre sonra tekrar deneyiniz.");
                        $("#errorBlock").show();
                    }
                    
                }
            })
        }

        function setTimer(sayac) {
            var geriSayac = setInterval(function () {
                sayac--;

                if (sayac <= 0) {
                    clearInterval(geriSayac);

                    $("#loader").hide();
                    $("#formBlock").hide();

                    $("#errorMessage").empty().text("İşlem zaman aşımına uğradı!");
                    $("#errorBlock").show();

                } else {
                    $("#timeOut").html(convertStoMs(sayac));
                }
            }, 1000);
        }

        function convertStoMs(seconds) {
            let minutes = ~~(seconds / 60);
            let extraSeconds = Math.floor(seconds % 60);
            let minutesText = minutes < 10 ? "0" + minutes : minutes;
            let extraSecondsText = extraSeconds < 10 ? "0" + extraSeconds : extraSeconds;
            return minutesText + ":" + extraSecondsText;
        }

    </script>

</body>
</html>