@using Transactions.Models.ViewModels
@model FastOptionsViewModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">

        <title>@Model.WebsiteTitle Havale</title>

        <meta name="robots" content="noindex, nofollow">
        <meta name="content-language" content="tr">
        <meta name="resource-type" content="document">
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="black" />
        <meta name="msapplication-TileColor" content="#da532c">
        <meta name="theme-color" content="#ffffff">

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">

        <link rel="stylesheet" href="~/v3/styles/fast-options.css" asp-append-version="true">

    </head>
<body>

    <div class="container py-2">
        <div class="card payment-card">
            <!-- Logo -->
            <div class="logo-container">
                <div class="logo-icon">
                    <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                        <path d="M20 4L4 12H36L20 4Z" fill="white" />
                        <rect x="6" y="12" width="28" height="4" fill="white" />
                        <rect x="8" y="16" width="4" height="16" fill="white" />
                        <rect x="18" y="16" width="4" height="16" fill="white" />
                        <rect x="28" y="16" width="4" height="16" fill="white" />
                        <rect x="4" y="32" width="32" height="4" fill="white" />
                    </svg>
                </div>
                <h1 class="logo-text">@Model.WebsiteTitle Havale</h1>
            </div>

            <!-- Content -->
            <div class="card-body">
                <h2 class="title">Havale Yöntemi Seçiniz</h2>

                <div class="payment-options">
                    <a href="@Url.Action("Index", "Home", new { transaction = Model.TransactionId, isFast = true }).Replace("/Home/Index", "/")" class="option-button">
                        <div class="option-content">
                            <div class="option-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                                    <line x1="2" y1="10" x2="22" y2="10"></line>
                                </svg>
                            </div>
                            <div class="option-text">
                                <p class="option-title">Fast ile yatırmak istiyorum</p>
                                <p class="option-subtitle">Hızlı ve kolay havale</p>
                            </div>
                        </div>
                        <div class="option-arrow">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </div>
                    </a>

                    <a href="@Url.Action("BankList", "Home", new { transaction = Model.TransactionId }).Replace("/Home/BankList", "/")" class="option-button">
                        <div class="option-content">
                            <div class="option-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M3 6c0-1.1.9-2 2-2h14a2 2 0 0 1 2 2M3 6v12a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6"></path>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                            </div>
                            <div class="option-text">
                                <p class="option-title">Banka seçmek istiyorum</p>
                                <p class="option-subtitle">Bankanızı seçerek devam edin</p>
                            </div>
                        </div>
                        <div class="option-arrow">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>