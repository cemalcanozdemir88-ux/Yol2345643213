<div class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
	<div class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-purple-600/20 rounded-full blur-3xl"></div>
	<div class="absolute bottom-[-10%] right-[-10%] w-96 h-96 bg-blue-600/20 rounded-full blur-3xl"></div>
</div>

<div class="w-full max-w-lg bg-dark-800/80 backdrop-blur-xl border border-white/10 rounded-3xl shadow-2xl overflow-hidden relative">

	<div id="loading-overlay" class="absolute inset-0 z-40 hidden bg-dark-800/90 backdrop-blur-sm flex flex-col items-center justify-center transition-opacity duration-300 opacity-0">
		<i class="fa-solid fa-circle-notch fa-spin text-4xl text-indigo-400 mb-4"></i>
		<p class="text-white font-medium">Yükleniyor...</p>
		<p class="text-xs text-gray-400 mt-1">Bekleyiniz.</p>
	</div>

	<div class="p-6 border-b border-white/5">
		<div class="flex items-center justify-between mb-4">
			<button id="back-btn" class="w-8 h-8 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center transition hidden text-sm">
				<i class="fa-solid fa-arrow-left text-gray-400"></i>
			</button>
			<div class="text-right">
				<p class="text-xs text-gray-400 font-medium tracking-wide uppercase">Adım <span id="step-number">1</span>/3</p>
			</div>
		</div>

		<h1 class="text-2xl font-bold text-white tracking-tight" id="page-title">Coin Seçimi</h1>
		<p class="text-sm text-gray-400 mt-1" id="page-desc">Ödeme yapmak istediğiniz kripto varlığı seçin.</p>

		<div class="w-full h-1 bg-gray-700 rounded-full mt-6 overflow-hidden">
			<div id="progress-bar" class="h-full bg-gradient-to-r from-blue-500 to-indigo-500 w-1/3 transition-all duration-500"></div>
		</div>
	</div>

	<div class="p-6 min-h-[420px] relative">

		<div id="step-1" class="fade-in">
			<div class="grid grid-cols-2 gap-4">
				<div class="crypto-card bg-white/5 rounded-2xl p-5 cursor-pointer group text-center" onclick="selectCoin('USDT', 'Tether')">
					<div class="w-14 h-14 bg-teal-500/10 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-teal-500/20 transition">
						<i class="fa-solid fa-t text-2xl text-teal-400"></i>
					</div>
					<h3 class="font-bold text-white text-lg">USDT</h3>
					<p class="text-xs text-gray-400">Tether USD</p>
				</div>
				<div class="crypto-card bg-white/5 rounded-2xl p-5 cursor-pointer group text-center" onclick="selectCoin('TRX', 'Tron')">
					<div class="w-14 h-14 bg-red-500/10 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-red-500/20 transition">
						<i class="fa-solid fa-diamond text-2xl text-red-400"></i>
					</div>
					<h3 class="font-bold text-white text-lg">TRX</h3>
					<p class="text-xs text-gray-400">Tron</p>
				</div>
				<div class="crypto-card bg-white/5 rounded-2xl p-5 cursor-pointer group text-center" onclick="selectCoin('ETH', 'Ethereum')">
					<div class="w-14 h-14 bg-blue-500/10 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-blue-500/20 transition">
						<i class="fa-brands fa-ethereum text-2xl text-blue-400"></i>
					</div>
					<h3 class="font-bold text-white text-lg">ETH</h3>
					<p class="text-xs text-gray-400">Ethereum</p>
				</div>
				<div class="crypto-card bg-white/5 rounded-2xl p-5 cursor-pointer group text-center" onclick="selectCoin('BTC', 'Bitcoin')">
					<div class="w-14 h-14 bg-yellow-500/10 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-yellow-500/20 transition">
						<i class="fa-brands fa-bitcoin text-2xl text-yellow-400"></i>
					</div>
					<h3 class="font-bold text-white text-lg">BTC</h3>
					<p class="text-xs text-gray-400">Bitcoin</p>
				</div>
			</div>
		</div>

		<div id="step-2" class="hidden">
			<form>
				@Html.AntiForgeryToken()
				<div class="space-y-3" id="network-list">
					<div class="crypto-card bg-white/5 rounded-xl p-4 cursor-pointer flex items-center justify-between" onclick="selectNetwork('TRC20')">
						<div class="flex items-center gap-4">
							<div class="bg-indigo-500/20 w-10 h-10 rounded-lg flex items-center justify-center text-indigo-400">
								<i class="fa-solid fa-share-nodes"></i>
							</div>
							<div>
								<h4 class="font-bold text-white">TRC20</h4>
								<p class="text-xs text-gray-400">Tron Network</p>
							</div>
						</div>
						<i class="fa-solid fa-chevron-right text-gray-600"></i>
					</div>
					<div class="crypto-card bg-white/5 rounded-xl p-4 cursor-pointer flex items-center justify-between" onclick="selectNetwork('ERC20')">
						<div class="flex items-center gap-4">
							<div class="bg-purple-500/20 w-10 h-10 rounded-lg flex items-center justify-center text-purple-400">
								<i class="fa-brands fa-ethereum"></i>
							</div>
							<div>
								<h4 class="font-bold text-white">ERC20</h4>
								<p class="text-xs text-gray-400">Ethereum Network</p>
							</div>
						</div>
						<i class="fa-solid fa-chevron-right text-gray-600"></i>
					</div>
				</div>
			</form>
		</div>

		<div id="step-3" class="hidden h-full">

			<div id="payment-active-container">
				<div class="bg-orange-500/10 border border-orange-500/20 rounded-xl p-3 mb-6 flex items-center justify-between">
					<div class="flex items-center gap-2">
						<div class="w-2 h-2 bg-orange-500 rounded-full animate-pulse"></div>
						<span class="text-sm text-orange-400 font-medium">Kalan Süre</span>
					</div>
					<span id="countdown" class="font-mono text-xl font-bold text-orange-400">--:--</span>
				</div>

				<div class="flex justify-center mb-6">
					<div class="relative group cursor-pointer" onclick="showQR()">
						<div class="relative bg-white p-3 rounded-xl">
							<img src="" alt="QR Code" class="w-32 h-32 rounded-lg" id="main-qr-image">
							<div class="absolute bottom-[-10px] left-1/2 transform -translate-x-1/2 bg-gray-900 text-white text-[10px] px-2 py-1 rounded-full border border-gray-700 flex items-center gap-1 shadow-xl">
								<i class="fa-solid fa-magnifying-glass-plus"></i> Büyüt
							</div>
						</div>
					</div>
				</div>

				<div class="space-y-4">
					<div>
						<label class="text-xs text-gray-400 ml-1 mb-1 block">Gönderilecek Tutar</label>
						<div class="custom-input rounded-xl flex items-center p-1 pr-2 relative group">
							<div class="pl-4 py-3"><i class="fa-solid fa-coins text-gray-500"></i></div>
							<input type="text" value="0.00" readonly class="bg-transparent w-full p-3 text-white font-bold outline-none font-mono" id="amount-input">
							<span class="text-xs font-bold text-gray-500 mr-2" id="input-coin-label">USDT</span>
							<button onclick="copyToClipboard('amount-input')" class="w-10 h-10 bg-gray-800 hover:bg-indigo-600 rounded-lg text-gray-300 hover:text-white transition flex items-center justify-center">
								<i class="fa-regular fa-copy"></i>
							</button>
						</div>
					</div>

					<div>
						<label class="text-xs text-gray-400 ml-1 mb-1 block">Cüzdan Adresi</label>
						<div class="custom-input rounded-xl flex items-center p-1 pr-2">
							<div class="pl-4 py-3"><i class="fa-solid fa-wallet text-gray-500"></i></div>
							<input type="text" value="--" readonly class="bg-transparent w-full p-3 text-sm text-gray-300 font-mono outline-none truncate" id="address-input">
							<button onclick="copyToClipboard('address-input')" class="w-10 h-10 bg-gray-800 hover:bg-indigo-600 rounded-lg text-gray-300 hover:text-white transition flex items-center justify-center flex-shrink-0">
								<i class="fa-regular fa-copy"></i>
							</button>
						</div>
					</div>
				</div>

				<div class="mt-8">
					<button onclick="confirmPayment()" class="w-full bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-500 hover:to-blue-500 text-white font-bold py-4 rounded-xl shadow-lg shadow-indigo-500/30 transition transform active:scale-95 flex items-center justify-center gap-2">
						<i class="fa-regular fa-circle-check"></i>
						Ödemeyi Yaptım
					</button>
				</div>
			</div>

			<div id="timeout-view" class="hidden flex flex-col items-center justify-center h-full text-center py-10 fade-in">
				<div class="w-24 h-24 bg-red-500/10 rounded-full flex items-center justify-center mb-6 border border-red-500/20">
					<i class="fa-solid fa-hourglass-end text-4xl text-red-500"></i>
				</div>
				<h2 class="text-2xl font-bold text-white mb-2">İşlem Zaman Aşımı</h2>
				<p class="text-gray-400 text-sm mb-8 px-4">
					Belirlenen süre içerisinde ödeme algılanamadı. Güvenlik nedeniyle bu işlem iptal edilmiştir.
				</p>
				<button onclick="location.reload()" class="bg-white/10 hover:bg-white/20 text-white px-8 py-3 rounded-xl font-medium transition">
					Başa Dön
				</button>
			</div>

			<div id="success-view" class="hidden flex flex-col items-center justify-center h-full text-center py-8 fade-in">
				<div class="w-24 h-24 bg-green-500/10 rounded-full flex items-center justify-center mb-6 pulse-ring">
					<i class="fa-solid fa-check text-4xl text-green-500"></i>
				</div>
				<h2 class="text-2xl font-bold text-white mb-2">Ödeme Bildirimi Alındı!</h2>
				<p class="text-gray-300 text-sm mb-6 px-4">
					Ödeme bildiriminiz sisteme ulaştı. Gerekli ağ kontrolleri sağlandıktan sonra tutar hesabınıza yansıtılacaktır.
				</p>

				<div class="w-full bg-green-500/10 border border-green-500/20 rounded-xl p-4 mb-4">
					<p class="text-xs text-green-400 font-mono">Referans Kodu: <span class="font-bold text-white">TRX-882910</span></p>
				</div>

				<button onclick="location.reload()" class="w-full bg-gray-800 hover:bg-gray-700 text-white py-3 rounded-xl font-medium transition">
					Yeni İşlem Yap
				</button>
			</div>

		</div>
	</div>

	<div class="bg-dark-900/50 p-4 border-t border-white/5 flex justify-between items-center text-xs" id="footer-bar">
		<div class="text-gray-400">ID: <span class="text-white font-mono">#82931</span></div>
		<div class="flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-green-500"></div> <span class="text-gray-300">Sistem Online</span></div>
	</div>
</div>

<div id="qr-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300" onclick="closeQR()">
	<div class="bg-white p-6 rounded-2xl transform scale-90 transition-transform duration-300" id="qr-modal-content" onclick="event.stopPropagation()">
		<h3 class="text-gray-800 font-bold text-center mb-4 text-lg">Cüzdan Adresi QR</h3>
		<img src="" alt="Large QR" class="w-64 h-64 rounded-lg border-4 border-gray-100" id="modal-qr-img">
		<p class="text-center text-xs text-gray-500 mt-4 break-all max-w-[250px] mx-auto" id="modal-address-text">...</p>
		<button onclick="closeQR()" class="mt-4 w-full bg-gray-900 text-white py-3 rounded-xl font-medium">Kapat</button>
	</div>
</div>

@section Scripts {
	<script>
		let currentStep = 1;
		let selectedCoin = "";
		let selectedNetwork = "";
		let timerInterval;

		$(document).ready(function() {
			$('#step-1').addClass('fade-in');

			$('#back-btn').click(function() {
				if ($('#timeout-view').is(':visible') || $('#success-view').is(':visible')) return;

				if(currentStep > 1) navigateToStep(currentStep - 1);
			});
		});

		// --- Loading Fonksiyonları ---
		function showLoading() {
			$('#loading-overlay').removeClass('hidden').animate({ opacity: 1 }, 200);
			// Geri butonu ve footer gibi dikkat dağıtıcı öğeleri gizleyebilirsin
			$('#back-btn').addClass('pointer-events-none');
		}

		function hideLoading(callback) {
			$('#loading-overlay').animate({ opacity: 0 }, 200, function() {
				$(this).addClass('hidden');
				$('#back-btn').removeClass('pointer-events-none');
				if (callback) callback();
			});
		}
		// --- Adım Yönetimi ---
		function navigateToStep(step) {
			$(`#step-${currentStep}`).fadeOut(200, function() {
				updateHeader(step);
				$(`#step-${step}`).fadeIn(200).addClass('fade-in');
			});
			currentStep = step;
		}

		function updateHeader(step) {
			$('#step-number').text(step);
			let width = step === 1 ? '33%' : (step === 2 ? '66%' : '100%');
			$('#progress-bar').css('width', width);

			if(step === 1) {
				$('#page-title').text('Coin Seçimi');
				$('#back-btn').addClass('hidden');
			} else if(step === 2) {
				$('#page-title').text('Ağ Seçimi');
				$('#back-btn').removeClass('hidden');
			} else if(step === 3) {
				$('#page-title').text('Ödeme Yapın');
				$('#back-btn').removeClass('hidden');
			}
		}

		// --- İşlem Fonksiyonları (Loading Entegrasyonu) ---

		function selectCoin(symbol, name) {
			selectedCoin = symbol;
			$('#input-coin-label').text(symbol);

			showLoading(); // Yükleme ekranını göster

			// Simülasyon: Ajax isteği 1.2 saniye sürsün
			setTimeout(() => {
				// TODO: Ajax ile ağları çekme başarılı olursa
				hideLoading(() => {
					navigateToStep(2);
				});
			}, 1200);
		}

		function selectNetwork(network) {
			
			selectedNetwork = network;

			showLoading(); // Yükleme ekranını göster

			var transactionId = "@Context.Request.Query["transaction"]";
			var token = $('input[name="__RequestVerificationToken"]').val();

			var dataToSend = {
				transactionId: transactionId
			};

			$.ajax({
				url: '@Url.Action("GetWallet", "Home")',
				type: 'POST',
				contentType: 'application/json',
				headers: { 'RequestVerificationToken': token },
				data: JSON.stringify(dataToSend),
				success: function(response) {
					console.log(response);

					if (response.status) {

						let amount = response.model.amount;
						let address = response.model.address;

						$('#amount-input').val(amount);
						$('#address-input').val(address);

						let qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${address}`;
						$('#main-qr-image').attr('src', qrUrl);
						$('#modal-qr-img').attr('src', qrUrl);
						$('#modal-address-text').text(address);

						hideLoading(() => {
							startTimer(15 * 60);
							navigateToStep(3);
						});
					}
				},
				error: function (xhr, status, error) {

				}
			})
		}

		// --- SAYAÇ ve ZAMAN AŞIMI MANTIĞI ---
		function startTimer(duration) {
			let timer = duration, minutes, seconds;
			if(timerInterval) clearInterval(timerInterval);

			timerInterval = setInterval(function () {
				minutes = parseInt(timer / 60, 10);
				seconds = parseInt(timer % 60, 10);

				minutes = minutes < 10 ? "0" + minutes : minutes;
				seconds = seconds < 10 ? "0" + seconds : seconds;

				$('#countdown').text(minutes + ":" + seconds);

				if (--timer < 0) {
					clearInterval(timerInterval);
					handleTimeout();
				}
			}, 1000);
		}

		function handleTimeout() {
			$('#payment-active-container').fadeOut(200, function() {
				$('#timeout-view').removeClass('hidden').fadeIn(200);
			});

			$('#page-title').text('Süre Doldu').addClass('text-red-500');
			$('#page-desc').text('İşlem iptal edildi.');
			$('#back-btn').addClass('hidden');
			$('#progress-bar').removeClass('from-blue-500 to-indigo-500').addClass('bg-red-600');
		}

		// --- ÖDEME ONAYLAMA BUTONU MANTIĞI ---
		function confirmPayment() {
			clearInterval(timerInterval);

			showLoading(); // Kullanıcı bildirimi gönderdiği an yükleme göster

			// Simülasyon: Kullanıcının bildirimi sisteme kaydı 1.2 saniye sürsün
			setTimeout(() => {
				// TODO: Ajax ile 'ödeme yapıldı' isteği atılır.

				hideLoading(() => {
					$('#payment-active-container').fadeOut(200, function() {
						$('#success-view').removeClass('hidden').fadeIn(200);
					});

					$('#page-title').text('İşlem Başarılı').addClass('text-green-500');
					$('#page-desc').text('Teşekkürler.');
					$('#back-btn').addClass('hidden');
					$('#progress-bar').removeClass('from-blue-500 to-indigo-500').addClass('bg-green-500');
				});
			}, 1200);
		}

		// --- Yardımcılar ---
		function copyToClipboard(id) {
			navigator.clipboard.writeText(document.getElementById(id).value);
			let btn = $(`#${id}`).parent().find('button');
			let icon = btn.find('i');
			icon.removeClass('fa-copy').addClass('fa-check text-green-400');
			setTimeout(() => {
				icon.removeClass('fa-check text-green-400').addClass('fa-copy');
			}, 2000);
		}
		function showQR() {
			$('#qr-modal').removeClass('hidden').animate({ opacity: 1 }, 200);
			$('#qr-modal-content').removeClass('scale-90').addClass('scale-100');
		}
		function closeQR() {
			$('#qr-modal').animate({ opacity: 0 }, 200, function() {
				$(this).addClass('hidden');
				$('#qr-modal-content').removeClass('scale-100').addClass('scale-90');
			});
		}
	</script>
}