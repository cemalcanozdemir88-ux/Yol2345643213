@{
	Layout = null;
}

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
	<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">

	<title>@ViewBag.WebsiteTitle Havale</title>

	<meta name="robots" content="noindex, nofollow">
	<meta name="content-language" content="tr">
	<meta name="resource-type" content="document">
	<meta name="mobile-web-app-capable" content="yes" />
	<meta name="apple-mobile-web-app-status-bar-style" content="black" />
	<meta name="msapplication-TileColor" content="#da532c">
	<meta name="theme-color" content="#ffffff">

	<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
	<script src="https://cdn.tailwindcss.com"></script>


</head>

<body class="min-h-screen bg-gradient-to-br from-gray-50 to-green-50">

	<header class="bg-white shadow-sm">
		<div class="container mx-auto px-4 py-4 max-w-2xl">
			<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between">
				<div class="flex items-center">
					<div class="relative h-16 w-16 mr-4 group perspective-[1000px]">
						<div class="absolute top-0 left-0 h-full w-full bg-green-100 rounded-tr-3xl rounded-bl-3xl transition-transform duration-[1500ms] group-hover:rotate-y-180 backface-hidden">
							<div class="absolute top-0 left-0 h-full w-full flex items-center justify-center font-bold text-green-700 text-lg transform -rotate-45">
								NORTH
							</div>
						</div>
					</div>
					<div class="border-l-4 border-green-500 pl-3">
						<h1 class="text-lg font-semibold">Merhaba;</h1>
						<h2 class="text-xl font-bold text-green-700" id="fullName"></h2>
					</div>
				</div>
				<div class="mt-4 sm:mt-0 flex items-center bg-gray-50 px-4 py-2 rounded-md border border-gray-200">
					<span class="text-gray-500 text-sm mr-2">Kullanıcı Adı:</span>
					<div class="flex items-center">
						<svg class="w-4 h-4 text-green-600 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
						<span class="font-medium text-gray-700" id="username"></span>
					</div>
				</div>
			</div>
		</div>
	</header>

	<main class="container mx-auto px-4 py-8 max-w-2xl">
		<div id="accountDetails" class="bg-white rounded-lg shadow-lg overflow-hidden hidden">
			<div class="p-6 border-b border-gray-100 flex items-center justify-between">
				<div class="flex items-center space-x-2 text-green-700">
					<div id="timer" class="bg-green-100 text-green-800 rounded-full px-3 py-1 font-mono font-bold text-xl flex items-center justify-center w-20 h-20 border-4 border-green-200 animate-pulse">

					</div>
				</div>
				<div class="text-sm text-red-500 font-medium">
					Lütfen sayaç sona ermeden işleminizi gerçekleştiriniz...
				</div>
			</div>

			<div class="p-6">

				<form>
					@Html.AntiForgeryToken()
					<input type="hidden" id="havaleBankId" name="havaleBankId" />

					<div class="space-y-6">
						<div class="grid grid-cols-12 items-center gap-4">
							<div class="col-span-12 sm:col-span-4">
								<label class="block text-sm font-medium text-green-700 mb-1">
									Yatırım Tutarı:
								</label>
							</div>
							<div class="col-span-12 sm:col-span-8">
								<div class="relative">
									<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
										<span class="h-5 w-5 text-gray-400">₺</span>
									</div>
									<input type="text" id="amount-value" readonly class="block w-full pl-10 pr-12 py-3 border border-gray-300 rounded-md shadow-sm bg-gray-50">
									<div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
										<span class="text-gray-500 sm:text-sm">TL</span>
									</div>
								</div>
							</div>
						</div>

						<div class="grid grid-cols-12 items-center gap-4">
							<div class="col-span-12 sm:col-span-4">
								<label class="block text-sm font-medium text-green-700 mb-1">
									Hesap İsim Soyisim:
								</label>
							</div>
							<div class="col-span-12 sm:col-span-8">
								<div class="relative">
									<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
										<svg class="h-5 w-5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
									</div>
									<input type="text" id="accountName" value="" readonly class="block w-full pl-10 pr-12 py-3 border border-gray-300 rounded-md shadow-sm bg-gray-50">
									<button class="copy-btn absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-green-600" data-target="accountName">
										<svg class="copy-icon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
										<svg class="success-icon h-5 w-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
									</button>
								</div>
							</div>
						</div>

						<div class="grid grid-cols-12 items-center gap-4">
							<div class="col-span-12 sm:col-span-4">
								<label class="block text-sm font-medium text-green-700 mb-1">
									IBAN Bilgisi:
								</label>
							</div>
							<div class="col-span-12 sm:col-span-8">
								<div class="relative">
									<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
										<svg class="h-5 w-5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2" /><line x1="1" y1="10" x2="23" y2="10" /></svg>
									</div>
									<input type="text" id="iban" value="" readonly class="block w-full pl-10 pr-12 py-3 border border-gray-300 rounded-md shadow-sm bg-gray-50">
									<button class="copy-btn absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-green-600" data-target="iban">
										<svg class="copy-icon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
										<svg class="success-icon h-5 w-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
									</button>
								</div>
							</div>
						</div>

						<div class="mt-8 flex justify-center">
							<button id="submitBtn" class="flex items-center justify-center px-6 py-3 bg-green-600 hover:bg-green-700 text-white font-medium rounded-md shadow-sm transition-colors duration-200 gap-2 w-full sm:w-auto">
								<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
								TALEP GÖNDER
							</button>
						</div>
					</div>

				</form>

			</div>
			<div class="bg-green-50 p-6 border-t border-green-100">
				<div class="space-y-3">
					<div class="flex items-start space-x-3">
						<div class="flex-shrink-0 pt-1">
							<span class="inline-block h-4 w-4 text-green-500">✦</span>
						</div>
						<p class="text-sm text-green-700">
							Bankanızdan para yatırımınız kutucuğa yazdığınız tutar ile aynı olmalıdır.
						</p>
					</div>
					<div class="flex items-start space-x-3">
						<div class="flex-shrink-0 pt-1">
							<span class="inline-block h-4 w-4 text-green-500">✦</span>
						</div>
						<p class="text-sm text-green-700">
							Yatırımınızı sadece kendi bankanıza ait hesabınızdan transfer yapmanız gereklidir.
						</p>
					</div>
					<div class="flex items-start space-x-3">
						<div class="flex-shrink-0 pt-1">
							<span class="inline-block h-4 w-4 text-green-500">✦</span>
						</div>
						<p class="text-sm text-green-700">
							Geri sayım bitmeden yatırımı yapmanız ve TALEP GÖNDER butonuna basmanız gereklidir.
						</p>
					</div>
					<div class="flex items-start space-x-3">
						<div class="flex-shrink-0 pt-1">
							<span class="inline-block h-4 w-4 text-green-500">✦</span>
						</div>
						<p class="text-sm text-green-700">
							Bankanızdan yaptığınız her transfer için açıklamayı boş bırakmanız önemle rica olunur
						</p>
					</div>
				</div>
			</div>
		</div>

		<div id="loadingScreen" class="bg-white rounded-lg shadow-lg overflow-hidden">
			<div class="p-6 text-center">
				<div class="bg-green-50 p-4 rounded-lg">
					<div class="loading-spinner mx-auto h-12 w-12 text-green-400 mb-4"></div>
					<h3 class="text-lg font-medium text-green-800">Hesap bilgileri yükleniyor lütfen bekleyiniz</h3>
					<p class="text-sm text-green-700">
						Bu işlem birkaç dakika sürebilir, lütfen sayfayı kapatmayınız.
					</p>
				</div>
			</div>
		</div>

		<div id="successMessage" class="bg-white rounded-lg shadow-lg overflow-hidden hidden">
			<div class="p-6 text-center">
				<div class="bg-green-50 p-4 rounded-lg">
					<svg class="mx-auto h-12 w-12 text-green-400 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
					<h3 class="text-lg font-medium text-green-800">Talebiniz başarıyla alındı</h3>
					<p class="text-sm text-green-700">İşleminiz en kısa sürede sonuçlandırılıp bakiyenize yansıyacaktır.</p>
				</div>
				<div class="mt-8 flex justify-center">
					<button id="redirectBtn" class="flex items-center justify-center px-6 py-3 bg-green-600 hover:bg-green-700 text-white font-medium rounded-md shadow-sm transition-colors duration-200 gap-2 w-full sm:w-auto">
						<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
						SİTEYE DÖN
					</button>
				</div>
			</div>
		</div>

		<div id="timeoutMessage" class="bg-white rounded-lg shadow-lg overflow-hidden hidden">
			<div class="p-6 text-center">
				<div class="bg-red-50 p-4 rounded-lg">
					<svg class="mx-auto h-12 w-12 text-red-400 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
					<h3 class="text-lg font-medium text-red-800">İşlem zaman aşımına uğradı</h3>
				</div>
			</div>
		</div>

		<div id="errorScreen" class="bg-white rounded-lg shadow-lg overflow-hidden hidden">
			<div class="p-6 text-center">
				<div class="bg-red-50 p-4 rounded-lg">
					<svg class="mx-auto h-12 w-12 text-red-400 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
					<h3 class="text-lg font-medium text-red-800" id="errorMessage">

					</h3>
				</div>
			</div>
		</div>

	</main>

	<!-- YENİ EKLENEN POP-UP HTML -->
	<div id="popup-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 hidden"></div>
	<div id="popup-modal" class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-white rounded-lg shadow-2xl z-50 w-11/12 max-w-md hidden">
		<div class="flex justify-between items-center p-4 border-b">
			<h3 class="text-lg font-semibold text-gray-800">Önemli Bilgilendirme</h3>
			<button id="close-popup" class="text-gray-400 hover:text-gray-600">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
			</button>
		</div>
		<div class="p-6">
			<p class="text-gray-600">
				Minimum yatırım tutarından düşük gönderimlerinizde tutar tarafınıza <b>24 saat sonra iade edilecektir</b>. <br />
				Minimum yatırım tutarı altında gönderim <b>yapmamanızı</b> rica ederiz.
			</p>
		</div>
		<div class="p-4 bg-gray-50 border-t flex justify-end">
			<button id="close-popup-btn" class="px-4 py-2 bg-green-600 text-white rounded-md hover:bg-green-700">
				Kapat
			</button>
		</div>
	</div>
	<!-- POP-UP HTML SONU -->

	<style>
		.perspective-\[1000px\] {
			perspective: 1000px;
		}

		.backface-hidden {
			backface-visibility: hidden;
			-webkit-backface-visibility: hidden;
		}

		.rotate-y-180 {
			transform: rotateY(180deg);
		}

		@@keyframes pulse {
			0%, 100% {
				opacity: 1;
			}

			50% {
				opacity: .7;
			}
		}

		.animate-pulse {
			animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
		}

		.loading-spinner {
			border-radius: 50%;
			width: 3rem;
			height: 3rem;
			border: 0.25rem solid rgba(21, 128, 61, 0.3);
			border-top-color: rgb(21 128 61 / var(--tw-text-opacity, 1));
			animation: spin 1s linear infinite;
		}

		@@keyframes spin {
			to {
				transform: rotate(360deg);
			}
		}

	</style>

	<script>
		$(document).ready(function() {

			$('#popup-overlay').show();
			$('#popup-modal').show();

			var redirectUrl = document.referrer;
			var getValidBankAccountErrorCount = 0;

			let geriSayac;

			GetValidBankAccount();

			function GetValidBankAccount() {
				var transactionId = "@Context.Request.Query["transaction"]";
				var bankaId = "@Context.Request.Query["banka"]";
				var token = $('input[name="__RequestVerificationToken"]').val();

				var dataToSend = {
					transactionId: transactionId,
					bankaId: bankaId
				};

				$.ajax({
					url: '@Url.Action("GetValidBankAccount", "Home")',
					type: 'POST',
					contentType: 'application/json',
					headers: { 'RequestVerificationToken': token },
					data: JSON.stringify(dataToSend),
					success: function (response) {
						if (!response.status) {

							$("#loadingScreen").hide();
							$("#accountDetails").hide();
							$("#successMessage").hide();
							$("#timeoutMessage").hide();

							$("#errorMessage").empty().text(response.message);
							$("#errorScreen").show();
						}
						else {

							$("#havaleBankId").val(response.model.id);

							$("#fullName").text(response.model.fullname);
							$("#username").text(response.model.username);

							$("#amount-value").val(response.model.amount);
							$("#accountName").val(response.model.hesapSahibi);
							$("#iban").val(response.model.hesapNo);

							if(redirectUrl === "" ||
							   redirectUrl == undefined ||
							   redirectUrl == null) {

								redirectUrl = response.model.webSiteUrl;
							}

							var sayac = JSON.parse(response.model.timeLeft);
							setTimer(sayac);

							$('#loadingScreen').hide();
							$('#errorScreen').hide();
							$("#successMessage").hide();
							$("#timeoutMessage").hide();

							$('#accountDetails').show();

						}
					},
					error: function (xhr, status, error) {
						getValidBankAccountErrorCount++;

						if (getValidBankAccountErrorCount == 1) {
							GetValidBankAccount();
						}
						else {
							$("#loadingScreen").hide();
							$("#accountDetails").hide();
							$("#successMessage").hide();
							$("#timeoutMessage").hide();

							$("#errorMessage").empty().text("Hata oluştu!. Bir süre sonra tekrar deneyiniz.");
							$("#errorScreen").show();
						}
					}
				})
			}

			function setTimer(sayac) {
				geriSayac = setInterval(function() {
					 sayac--;

					 if (sayac <= 0) {
						clearInterval(geriSayac);

						$("#accountDetails").hide();
						$("#timeoutMessage").show();
						return;

					 }else {

						 $('#timer').text(convertStoMs(sayac));
					 }


				}, 1000);
			}

			function convertStoMs(seconds) {
				let minutes = ~~(seconds / 60);
				let extraSeconds = Math.floor(seconds % 60);
				let minutesText = minutes < 10 ? "0" + minutes : minutes;
				let extraSecondsText = extraSeconds < 10 ? "0" + extraSeconds : extraSeconds;

				return minutesText + ":" + extraSecondsText;
			}

			// Copy button functionality
			$('.copy-btn').click(function(e) {
				e.preventDefault();

				const targetId = $(this).data('target');
				const textToCopy = $('#' + targetId).val();
				navigator.clipboard.writeText(textToCopy);

				const $btn = $(this);
				$btn.find('.copy-icon').hide();
				$btn.find('.success-icon').show();

				setTimeout(function() {
					$btn.find('.success-icon').hide();
					$btn.find('.copy-icon').show();
				}, 1500);
			});

			// Submit button functionality
			$('#submitBtn').click(function(e) {
				e.preventDefault();

				clearInterval(geriSayac);

				$('#accountDetails').hide();
				$('#successMessage').show();
			});

			$('#redirectBtn').on('click', function() {
				location.href = redirectUrl;
			});

			$('#close-popup, #close-popup-btn').click(function() {
				$('#popup-overlay').hide();
				$('#popup-modal').hide();
			});

		});
	</script>
</body>

</html>